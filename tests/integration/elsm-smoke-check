#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    printf 'Usage: elsm-smoke-check [--help]\nRead-only integration smoke check; no state is changed.\n'
}

if (($# > 0)); then
    if (($# == 1)) && [[ $1 == --help ]]; then usage; exit 0; fi
    usage >&2
    exit 2
fi

failures=0
check() {
    local name=$1
    shift
    if "$@"; then printf 'PASS | %s\n' "$name"; else printf 'FAIL | %s\n' "$name"; failures=$((failures + 1)); fi
}

printf 'ELSM integration smoke check: %s\n' "$(date --iso-8601=seconds)"
if [[ -r /etc/redhat-release ]]; then
    printf 'INFO | distribution | %s\n' "$(< /etc/redhat-release)"
else
    printf 'FAIL | target distribution | /etc/redhat-release unavailable\n'
    failures=$((failures + 1))
fi

if command -v mountpoint >/dev/null 2>&1; then
    check '/srv/company mounted' mountpoint -q /srv/company
else
    printf 'FAIL | required command mountpoint missing\n'
    failures=$((failures + 1))
fi
if command -v systemctl >/dev/null 2>&1; then
    check 'sshd active' systemctl is-active --quiet sshd
    check 'httpd active' systemctl is-active --quiet httpd
    if [[ -x /usr/local/sbin/elsm-backup ]]; then
        check 'backup timer enabled' systemctl is-enabled --quiet elsm-backup.timer
    else
        printf 'BLOCKED | backup | Part 07 is not installed\n'
        failures=$((failures + 1))
    fi
    if systemctl is-enabled --quiet nfs-server 2>/dev/null; then
        check 'nfs-server active' systemctl is-active --quiet nfs-server
    else
        printf 'SKIP | NFS | service is not enabled\n'
    fi
else
    printf 'FAIL | required command systemctl missing\n'
    failures=$((failures + 1))
fi
if command -v getenforce >/dev/null 2>&1; then
    selinux_mode=$(getenforce)
    if [[ $selinux_mode == Enforcing ]]; then printf 'PASS | SELinux enforcing\n'; else printf 'FAIL | SELinux mode=%s\n' "$selinux_mode"; failures=$((failures + 1)); fi
else
    printf 'FAIL | required command getenforce missing\n'
    failures=$((failures + 1))
fi
if command -v firewall-cmd >/dev/null 2>&1; then
    check 'firewalld running' firewall-cmd --state
else
    printf 'FAIL | required command firewall-cmd missing\n'
    failures=$((failures + 1))
fi

if ((failures > 0)); then
    printf 'Smoke check found %s unmet condition(s); inspect component tests for details.\n' "$failures"
    exit 1
fi
printf 'Smoke check completed; this does not replace the full acceptance test plan.\n'

